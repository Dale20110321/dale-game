# 依赖（零运行时依赖）
node_modules/

# ★ dist/ 已经删掉了：index.html 直接以 ES module 加载 src/main.js，
#   没有构建步骤也没有打包产物，所以没有"忘了重新打包就跑旧代码"这个坑。
#   真要恢复 file:// 双击离线玩时再加回来（见 index.html 入口处的注释）。

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
npm-debug.log*
.cache/
tmp/
# 根目录的一次性校验脚本：本来就该进 tmp/，之前因为没这条规则
# 混进了版本库（11 个 tmp_*.mjs 被跟踪），在 .gitignore 补上之前已经
# 用 git rm --cached 移出索引（文件与提交历史都还在，随时可取回）。
tmp_*.mjs
tmp_*.js
tmp_*.txt
tmp_*.png

# 审查 agent 的实测脚本（写在仓库根而非 tmp/），不应进版本库
.audit-*/
.audit-*.mjs
