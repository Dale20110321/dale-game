# 依赖（零运行时依赖；node_modules 只给本地 autotest 用）
node_modules/

# 注意：dist/ 必须提交！
#   index.html 引用 dist/game.bundle.js，GitHub Pages / file:// 直开都靠它，
#   不提交会导致线上脚本 404、页面能看但所有按钮点不动。
#   改完源码用 build.bat（或 bun build src/main.js --outfile dist/game.bundle.js --target browser --format iife）重新生成。
# build/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
npm-debug.log*
.cache/
tmp/
# 根目录的一次性校验脚本：本来就该进 tmp/，之前因为没这条规则
# 混进了版本库（11 个 tmp_*.mjs 被跟踪），在 .gitignore 补上之前已经
# 用 git rm --cached 移出索引（文件与提交历史都还在，随时可取回）。
tmp_*.mjs
tmp_*.js
tmp_*.txt
tmp_*.png
